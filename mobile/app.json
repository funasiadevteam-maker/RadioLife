{
  "expo": {
    "name": "RadioLife",
    "slug": "mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigfm.app",
      "buildNumber": "104",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "Scan customer QR codes to take payment.",
        "NSLocationWhenInUseUsageDescription": "Show shops and services near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F26B2A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.bigfm.app",
      "versionCode": 104,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF5EC"
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      "expo-video",
      "expo-localization",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show shops and services near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
